# BOOT LAUNCHER for custom ROMs with a root `adb root` shell but NO `su` (e.g. a LineageOS
# "userdebug" build). Install as /system/etc/init/server-boot.rc.
# Runs server-boot.sh as root once Android has finished booting.
on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh /data/local/tmp/server-boot.sh
