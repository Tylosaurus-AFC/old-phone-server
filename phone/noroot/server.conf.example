# server.conf -- settings for the no-root scripts (Termux). Installed as ~/server/server.conf.
# Plain shell (`KEY=value`). charge.sh re-reads it every minute. See docs/*/12-*.md.

# Name of the proot-distro container that holds Debian and the bot.
CONTAINER=bot

# Phone maker's own charge limiter, whose state charge.sh should read:
#   oplus   Realme / OPPO / OnePlus ColorOS-OxygenOS: Settings > Battery > Battery health >
#           Custom charge limit (read from `settings system regular_charge_protection_*`)
#   (empty) just report "plugged in but not charging" as a paused charge.
# On any phone, turn on the maker's charge limit by hand (Samsung "Protect battery",
# Pixel "Adaptive charging"/"Limit to 80%", Xiaomi "Battery protection"...): without root
# these scripts cannot control the charger themselves.
OEM=
CHARGE_LIMIT_DEFAULT=80      # shown when the limit cannot be read

# Extras that need an external USB disk (see phone/noroot/extras/ and docs/*/13-*.md).
# Names of scripts in ~/server/extras/ (without .sh). charge.sh starts them when a disk is
# mounted and relaunches them if they die. Disable one without editing: touch ~/server/no-<name>
SERVICES=""                  # e.g. "webdav dlna jellyfin"
# Run once a day at 04:00. Format: "script args", e.g. "youtube-mirror.sh 3"
NIGHTLY=""
# Weekly backup of the bot's settings and secrets to <disk>/Backups (Sundays 04:00, keeps 8).
# The Backups folder is NOT served by the webdav/dlna extras (it holds the bot token).
WEEKLY_BACKUP=0

# Internet check used by charge.sh and bot.sh: TCP to these hosts, port 53 unless written
# host:port (any one answering = online). Change it if your network blocks public DNS
# servers, e.g. NET_HOSTS="192.168.1.1:80" (your router's web page).
#NET_HOSTS="1.1.1.1 8.8.8.8"

# Through Shizuku, every 30 min the watchdog re-applies what keeps Android from freezing or
# killing Termux: battery-optimisation exemption, background activity, "active" standby
# bucket, and Android 12+'s phantom-process killer off. 0 = do not touch these settings.
# See docs/*/14-*.md.
#KEEPALIVE=1

# Automatic restart of Shizuku (thedjchi fork) when its service stops. Copy the value of
# "auth" from Shizuku > Settings > View intents. Without it the watchdog can only tell you
# that Shizuku stopped. Keep it private (it lets any app start/stop Shizuku).
#SHIZUKU_AUTH=

# If the bot stops answering for 15 min (no heartbeat), the watchdog sends you one Telegram
# message itself (with curl), retrying every 10 min until Telegram confirms it. 0 = never.
#BOTDOWN_ALERT=1
